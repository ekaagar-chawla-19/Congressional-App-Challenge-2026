{
  "expo": {
    "name": "HemlockID",
    "slug": "hemlockid",
    "scheme": "hemlockid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F2EC",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3B32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "HemlockID uses the camera to photograph tree bark.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HemlockID saves where each tree is so you can find it again."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HemlockID lets you pick bark photos you already took."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
